#!/bin/bash
source /opt/configuration/set_defaults.sh

INDEX="$PKI_DIR/index.txt"
if [ ! -f "$INDEX" ]; then
    echo "Error: Certificate database $INDEX not found." >&2
    exit 1
fi

# easyrsa moves revoked certificates out of issued/, so read the CA database instead
printf "%-20s %-8s %-17s %s\n" "USERNAME" "STATUS" "EXPIRES (UTC)" "SERIAL"
awk -F'\t' -v now="$(date -u +%Y%m%d%H%M%S)" -v server_cn="$OVPN_SERVER_CN" '
    {
        cn = $6
        sub(/.*\/CN=/, "", cn)
        sub(/\/.*/, "", cn)
        if (cn == "server" || cn == server_cn) next

        # UTCTime YYMMDDHHMMSSZ or GeneralizedTime YYYYMMDDHHMMSSZ
        expires = (length($2) == 13) ? "20" $2 : $2
        if ($1 == "R") status = "REVOKED"
        else if ($1 == "E" || substr(expires, 1, 14) <= now) status = "EXPIRED"
        else status = "VALID"

        printf "%-20s %-8s %s-%s-%s %s:%s  %s\n", cn, status,
            substr(expires, 1, 4), substr(expires, 5, 2), substr(expires, 7, 2),
            substr(expires, 9, 2), substr(expires, 11, 2), $4
    }' "$INDEX"
