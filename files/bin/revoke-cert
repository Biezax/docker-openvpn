#!/bin/bash
source /opt/configuration/set_defaults.sh

if [ -z "$1" ]; then
    echo "Usage: $0 <username>" >&2
    exit 1
fi

USERNAME="$1"
validate_client_name "$USERNAME" || exit 1

if [ ! -f "$PKI_DIR/issued/$USERNAME.crt" ]; then
    echo "Error: Certificate for user '$USERNAME' not found." >&2
    exit 1
fi

echo "Revoking certificate for user: $USERNAME"
if ! easyrsa revoke "$USERNAME" || ! easyrsa gen-crl; then
    echo "Error: Failed to revoke certificate for user '$USERNAME'." >&2
    exit 1
fi
if ! install_crl; then
    echo "Error: Failed to publish CRL; the revoked certificate may still be accepted." >&2
    exit 1
fi

echo "Certificate for user '$USERNAME' has been revoked; new connections with it are rejected."
echo "An already connected client is dropped at the next TLS renegotiation (within an hour)"
echo "or when the container is restarted."
