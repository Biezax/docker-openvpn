#!/bin/bash
source /opt/configuration/set_defaults.sh

if [ -z "$1" ]; then
    echo "Usage: $0 <username>" >&2
    exit 1
fi

USERNAME="$1"
validate_client_name "$USERNAME" || exit 1
if [[ ! "$USERNAME" =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]]; then
    echo "Error: invalid username '$USERNAME' (allowed: letters, digits, '.', '_', '@', '-')." >&2
    exit 1
fi

if [ -f "$PKI_DIR/issued/$USERNAME.crt" ]; then
    echo "Error: Certificate for user '$USERNAME' already exists." >&2
    echo "If you want to regenerate it, please revoke the existing certificate first." >&2
    exit 1
fi

echo "Generating certificate for user: $USERNAME (valid for $CLIENT_CERT_EXPIRE days)"
if ! easyrsa --days="$CLIENT_CERT_EXPIRE" build-client-full "$USERNAME" nopass; then
    echo "Error: Failed to generate certificate for user '$USERNAME'." >&2
    exit 1
fi

echo "Certificate for user '$USERNAME' has been successfully generated."
echo "Get the client configuration with: show-client-config $USERNAME"
